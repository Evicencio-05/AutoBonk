{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "python3 scripts/agent_guard.py cursor-shell", "timeout": 10, "failClosed": true }
    ],
    "beforeMCPExecution": [
      { "command": "python3 scripts/agent_guard.py cursor-mcp", "timeout": 10, "failClosed": true }
    ],
    "preToolUse": [
      { "command": "python3 scripts/agent_guard.py cursor-tool", "timeout": 10, "failClosed": true }
    ],
    "beforeSubmitPrompt": [
      { "command": "python3 scripts/agent_guard.py cursor-prompt", "timeout": 10 }
    ]
  }
}
