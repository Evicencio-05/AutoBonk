{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./config/accounts.yaml)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./config/agentic.yaml)",
      "Edit(./config/accounts.yaml)",
      "Edit(./rules/ta_rules.md)",
      "Edit(./alerts/state.json)",
      "Edit(./alerts/broker.json)",
      "Bash(python3 scripts/claim_alerts.py check:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_guard.py\" claude-tool", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_guard.py\" claude-prompt", "timeout": 10 }
        ]
      }
    ]
  }
}
