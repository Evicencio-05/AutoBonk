{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./config/accounts.yaml)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./config/agentic.yaml)",
      "Edit(./config/accounts.yaml)",
      "Edit(./rules/ta_rules.md)",
      "Edit(./alerts/state.json)",
      "Edit(./alerts/broker.json)",
      "Bash(python3 scripts/claim_alerts.py check:*)",
      "Bash(git push --force:*)",
      "Edit(./config/freeze.yaml)",
      "Edit(./bench/golden/**)",
      "Edit(./alerts/live.md)",
      "Edit(./alerts/paper.md)",
      "Edit(./alerts/log.md)",
      "Edit(./alerts/context.md)",
      "Edit(./alerts/contracts.md)",
      "Edit(./alerts/events.jsonl)",
      "Edit(./learning/trades.jsonl)",
      "Edit(./learning/trades.csv)",
      "Bash(python3 scripts/freeze.py bless:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_guard.py\" claude-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_guard.py\" claude-prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
